---
import { getTeams } from '@/lib/football-api';

// Fetch all teams for menu
const teams = await getTeams();

const navItems = [
  { label: 'Accueil', href: '/' },
  { label: 'Serie A', href: '/serie-a' },
  { label: 'Classement', href: '/classement' },
  { label: 'Résultats & Calendrier', href: '/resultats-calendrier' },
  { label: 'Formations Probables', href: '/formations-probables' },
  { label: 'Transferts', href: '/transferts' },
  {
    label: 'Équipes',
    submenu: teams.map((team) => ({
      label: team.name,
      href: `/equipes/${team.name.toLowerCase().replace(/\s+/g, '-')}`,
    })),
  },
  {
    label: 'Statistiques',
    submenu: [
      { label: 'Arbitres', href: '/arbitres' },
    ],
  },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-card border-b border-separator sticky top-0 z-50">
  <div class="container-custom">
    <!-- Top Bar -->
    <div class="flex items-center justify-between py-4">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <h1 class="text-3xl font-condensed font-bold text-accent">
          Vai Calcio
        </h1>
      </a>

      <!-- Search & Mobile Menu Button -->
      <div class="flex items-center gap-4">
        <!-- Search (desktop) -->
        <div class="hidden md:block">
          <input
            type="search"
            placeholder="Rechercher..."
            class="px-4 py-2 border border-separator rounded-sm text-sm focus:outline-none focus:border-accent"
            id="search-input"
          />
        </div>

        <!-- Mobile Menu Toggle -->
        <button
          class="md:hidden p-2"
          id="mobile-menu-toggle"
          aria-label="Toggle menu"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Navigation (desktop) -->
    <nav class="hidden md:block border-t border-separator">
      <ul class="flex items-center gap-1">
        {
          navItems.map((item) =>
            'submenu' in item && item.submenu ? (
              <li class="relative group">
                <button
                  class="block px-3 py-3 text-sm font-medium transition-colors hover:text-accent text-text"
                  type="button"
                >
                  {item.label} ▾
                </button>
                <div class="absolute left-0 top-full hidden group-hover:block bg-white border border-separator shadow-lg min-w-[200px] max-h-[400px] overflow-y-auto z-50">
                  {item.submenu.map((subitem) => (
                    <a
                      href={subitem.href}
                      class="block px-4 py-2 text-sm hover:bg-accent-light hover:text-accent transition-colors"
                    >
                      {subitem.label}
                    </a>
                  ))}
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class={`block px-3 py-3 text-sm font-medium transition-colors hover:text-accent ${
                    currentPath === item.href
                      ? 'text-accent border-b-2 border-accent'
                      : 'text-text'
                  }`}
                >
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>

    <!-- Mobile Navigation -->
    <nav class="md:hidden hidden" id="mobile-menu">
      <ul class="py-4 space-y-2 border-t border-separator">
        <!-- Search (mobile) -->
        <li class="px-4 pb-2">
          <input
            type="search"
            placeholder="Rechercher..."
            class="w-full px-4 py-2 border border-separator rounded-sm text-sm focus:outline-none focus:border-accent"
          />
        </li>

        {
          navItems.map((item, index) =>
            'submenu' in item && item.submenu ? (
              <li>
                <button
                  class="w-full text-left px-4 py-2 text-sm font-medium text-text flex items-center justify-between mobile-submenu-toggle"
                  type="button"
                  data-index={index}
                >
                  {item.label}
                  <span class="mobile-submenu-arrow">▾</span>
                </button>
                <div class="hidden mobile-submenu bg-accent-light" data-index={index}>
                  {item.submenu.map((subitem) => (
                    <a
                      href={subitem.href}
                      class="block px-8 py-2 text-sm text-text hover:text-accent"
                    >
                      {subitem.label}
                    </a>
                  ))}
                </div>
              </li>
            ) : (
              <li>
                <a
                  href={item.href}
                  class={`block px-4 py-2 text-sm font-medium transition-colors hover:text-accent ${
                    currentPath === item.href
                      ? 'text-accent bg-accent-light'
                      : 'text-text'
                  }`}
                >
                  {item.label}
                </a>
              </li>
            )
          )
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });

  // Mobile submenu toggles
  const submenuToggles = document.querySelectorAll('.mobile-submenu-toggle');
  submenuToggles.forEach((button) => {
    button.addEventListener('click', () => {
      const index = button.getAttribute('data-index');
      const submenu = document.querySelector(
        `.mobile-submenu[data-index="${index}"]`
      );
      const arrow = button.querySelector('.mobile-submenu-arrow');

      submenu?.classList.toggle('hidden');
      if (arrow) {
        arrow.textContent = submenu?.classList.contains('hidden') ? '▾' : '▴';
      }
    });
  });

  // Search functionality - redirect to /recherche
  const searchInputs = document.querySelectorAll('input[type="search"]');

  searchInputs.forEach((input) => {
    input.addEventListener('keypress', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        const query = (e.target as HTMLInputElement).value.trim();
        if (query) {
          window.location.href = `/recherche?q=${encodeURIComponent(query)}`;
        }
      }
    });
  });
</script>
