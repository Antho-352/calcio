---
const navItems = [
  { label: 'Accueil', href: '/' },
  { label: 'Serie A', href: '/serie-a' },
  { label: 'Classement', href: '/classement' },
  { label: 'Résultats & Calendrier', href: '/resultats-calendrier' },
  { label: 'Formations Probables', href: '/formations-probables' },
  { label: 'Transferts', href: '/transferts' },
  { label: 'Coppa Italia', href: '/coppa-italia' },
  { label: 'Squadra Azzurra', href: '/equipe-nationale' },
];

const currentPath = Astro.url.pathname;
---

<header class="bg-card border-b border-separator sticky top-0 z-50">
  <div class="container-custom">
    <!-- Top Bar -->
    <div class="flex items-center justify-between py-4">
      <!-- Logo -->
      <a href="/" class="flex items-center">
        <h1 class="text-3xl font-condensed font-bold text-accent">
          Vai Calcio
        </h1>
      </a>

      <!-- Search & Mobile Menu Button -->
      <div class="flex items-center gap-4">
        <!-- Search (desktop) -->
        <div class="hidden md:block">
          <input
            type="search"
            placeholder="Rechercher..."
            class="px-4 py-2 border border-separator rounded-sm text-sm focus:outline-none focus:border-accent"
            id="search-input"
          />
        </div>

        <!-- Mobile Menu Toggle -->
        <button
          class="md:hidden p-2"
          id="mobile-menu-toggle"
          aria-label="Toggle menu"
        >
          <svg
            class="w-6 h-6"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Navigation (desktop) -->
    <nav class="hidden md:block border-t border-separator">
      <ul class="flex items-center gap-1">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class={`block px-3 py-3 text-sm font-medium transition-colors hover:text-accent ${
                  currentPath === item.href
                    ? 'text-accent border-b-2 border-accent'
                    : 'text-text'
                }`}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <!-- Mobile Navigation -->
    <nav class="md:hidden hidden" id="mobile-menu">
      <ul class="py-4 space-y-2 border-t border-separator">
        <!-- Search (mobile) -->
        <li class="px-4 pb-2">
          <input
            type="search"
            placeholder="Rechercher..."
            class="w-full px-4 py-2 border border-separator rounded-sm text-sm focus:outline-none focus:border-accent"
          />
        </li>

        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class={`block px-4 py-2 text-sm font-medium transition-colors hover:text-accent ${
                  currentPath === item.href
                    ? 'text-accent bg-accent-light'
                    : 'text-text'
                }`}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  // Mobile menu toggle
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');

  toggle?.addEventListener('click', () => {
    menu?.classList.toggle('hidden');
  });
</script>
