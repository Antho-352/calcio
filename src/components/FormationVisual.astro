---
/**
 * Formation visualization on football pitch
 * Displays players in tactical formation with confidence scores
 */

interface Player {
  name: string;
  position?: string;
  confidence: number;
  sources: string[];
}

interface Props {
  formation: string; // e.g. "4-3-3", "3-5-2"
  players: Player[];
  teamName: string;
}

const { formation, players, teamName } = Astro.props;

// Parse formation (e.g. "4-3-3" => [4, 3, 3])
const formationLines = formation
  .split('-')
  .map((n) => parseInt(n, 10))
  .filter((n) => !isNaN(n));

// Distribute players across formation lines (GK + field)
const goalkeeper = players[0]; // Assume first player is GK
const fieldPlayers = players.slice(1, 11); // Next 10 are field players

// Distribute field players across lines
const playersByLine: Player[][] = [];
let playerIndex = 0;

for (const lineCount of formationLines) {
  const linePlayers = fieldPlayers.slice(playerIndex, playerIndex + lineCount);
  playersByLine.push(linePlayers);
  playerIndex += lineCount;
}

// Confidence color scale
const getConfidenceColor = (confidence: number): string => {
  if (confidence >= 80) return 'bg-green-600';
  if (confidence >= 60) return 'bg-green-500';
  if (confidence >= 40) return 'bg-yellow-500';
  if (confidence >= 20) return 'bg-orange-500';
  return 'bg-red-500';
};

const getConfidenceBorder = (confidence: number): string => {
  if (confidence >= 80) return 'border-green-600';
  if (confidence >= 60) return 'border-green-500';
  if (confidence >= 40) return 'border-yellow-500';
  if (confidence >= 20) return 'border-orange-500';
  return 'border-red-500';
};
---

<div class="formation-visual">
  <!-- Team header -->
  <div class="mb-4 text-center">
    <h3 class="font-condensed font-semibold text-xl">{teamName}</h3>
    <p class="text-sm text-text/60">Formation: {formation}</p>
  </div>

  <!-- Football pitch -->
  <div
    class="pitch relative bg-gradient-to-b from-green-600 to-green-700 rounded-lg overflow-hidden"
    style="aspect-ratio: 3/4; min-height: 500px;"
  >
    <!-- Pitch markings -->
    <div class="absolute inset-0 opacity-20">
      <!-- Center line -->
      <div
        class="absolute top-1/2 left-0 right-0 h-0.5 bg-white transform -translate-y-1/2"
      >
      </div>

      <!-- Center circle -->
      <div
        class="absolute top-1/2 left-1/2 w-24 h-24 border-2 border-white rounded-full transform -translate-x-1/2 -translate-y-1/2"
      >
      </div>

      <!-- Penalty areas -->
      <div class="absolute bottom-0 left-1/4 right-1/4 h-16 border-2 border-white border-b-0">
      </div>
      <div class="absolute top-0 left-1/4 right-1/4 h-16 border-2 border-white border-t-0">
      </div>

      <!-- Goal areas -->
      <div class="absolute bottom-0 left-1/3 right-1/3 h-8 border-2 border-white border-b-0">
      </div>
      <div class="absolute top-0 left-1/3 right-1/3 h-8 border-2 border-white border-t-0">
      </div>
    </div>

    <!-- Players -->
    <div class="absolute inset-0 flex flex-col justify-between p-4">
      <!-- Goalkeeper -->
      {
        goalkeeper && (
          <div class="flex justify-center mb-4">
            <div class="player-card text-center">
              <div
                class={`w-12 h-12 rounded-full ${getConfidenceColor(goalkeeper.confidence)} flex items-center justify-center text-white font-bold text-xs mx-auto mb-1 border-2 ${getConfidenceBorder(goalkeeper.confidence)}`}
              >
                GK
              </div>
              <p class="text-xs font-semibold text-white drop-shadow-md">
                {goalkeeper.name}
              </p>
              <p class="text-xs text-white/80">{goalkeeper.confidence}%</p>
            </div>
          </div>
        )
      }

      <!-- Field players by line -->
      {
        playersByLine.map((line, lineIndex) => (
          <div class="flex justify-around items-center">
            {line.map((player) => (
              <div class="player-card text-center">
                <div
                  class={`w-12 h-12 rounded-full ${getConfidenceColor(player.confidence)} flex items-center justify-center text-white font-bold text-xs mx-auto mb-1 border-2 ${getConfidenceBorder(player.confidence)}`}
                >
                  {player.position || ''}
                </div>
                <p class="text-xs font-semibold text-white drop-shadow-md max-w-[80px] truncate">
                  {player.name}
                </p>
                <p class="text-xs text-white/80">{player.confidence}%</p>
              </div>
            ))}
          </div>
        ))
      }
    </div>
  </div>

  <!-- Confidence legend -->
  <div class="mt-4 p-4 bg-gray-50 rounded-lg">
    <h4 class="font-semibold text-sm mb-3">Score de confiance</h4>
    <div class="grid grid-cols-5 gap-2 text-xs">
      <div class="flex items-center gap-1">
        <span class="w-3 h-3 bg-green-600 rounded-full"></span>
        <span>80%+</span>
      </div>
      <div class="flex items-center gap-1">
        <span class="w-3 h-3 bg-green-500 rounded-full"></span>
        <span>60-79%</span>
      </div>
      <div class="flex items-center gap-1">
        <span class="w-3 h-3 bg-yellow-500 rounded-full"></span>
        <span>40-59%</span>
      </div>
      <div class="flex items-center gap-1">
        <span class="w-3 h-3 bg-orange-500 rounded-full"></span>
        <span>20-39%</span>
      </div>
      <div class="flex items-center gap-1">
        <span class="w-3 h-3 bg-red-500 rounded-full"></span>
        <span>&lt;20%</span>
      </div>
    </div>
    <p class="text-xs text-text/60 mt-2">
      Le score reflète le nombre de sources italiennes citant ce joueur dans le
      onze de départ.
    </p>
  </div>
</div>

<style>
  .pitch {
    background-image: repeating-linear-gradient(
      0deg,
      rgba(255, 255, 255, 0.05) 0px,
      rgba(255, 255, 255, 0.05) 1px,
      transparent 1px,
      transparent 40px
    );
  }

  .player-card {
    transition: transform 0.2s;
  }

  .player-card:hover {
    transform: scale(1.1);
  }
</style>
