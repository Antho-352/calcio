---
import NewsletterForm from './NewsletterForm.astro';

// Sidebar component
// TODO: Fetch actual data from WordPress and API
// For now, placeholder content

const latestNews = [
  {
    title: 'Article récent 1',
    href: '/blog/article-1',
    date: '2026-04-17',
  },
  {
    title: 'Article récent 2',
    href: '/blog/article-2',
    date: '2026-04-16',
  },
  {
    title: 'Article récent 3',
    href: '/blog/article-3',
    date: '2026-04-15',
  },
];
---

<div class="space-y-6">
  <!-- Classement Widget -->
  <div class="card">
    <div class="p-4 border-b border-separator">
      <h3 class="font-condensed font-semibold text-lg">Classement Serie A</h3>
    </div>
    <div class="p-4">
      <p class="text-sm text-text/70">Classement à venir...</p>
      <!-- TODO: Replace with actual standings table -->
    </div>
  </div>

  <!-- Latest News Widget -->
  <div class="card">
    <div class="p-4 border-b border-separator">
      <h3 class="font-condensed font-semibold text-lg">Dernières actus</h3>
    </div>
    <div class="divide-y divide-separator">
      {
        latestNews.map((article) => (
          <a
            href={article.href}
            class="block p-4 hover:bg-accent-light transition-colors"
          >
            <h4 class="text-sm font-medium mb-1 line-clamp-2">
              {article.title}
            </h4>
            <p class="text-xs text-text/60">{article.date}</p>
          </a>
        ))
      }
    </div>
  </div>

  <!-- Newsletter Widget -->
  <div class="card p-4">
    <h3 class="font-condensed font-semibold text-lg mb-3">Newsletter</h3>
    <p class="text-sm text-text/70 mb-4">
      Recevez les dernières actus du Calcio chaque semaine.
    </p>
    <NewsletterForm />
  </div>
</div>
