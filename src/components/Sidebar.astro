---
import NewsletterForm from './NewsletterForm.astro';
import StandingsTable from './StandingsTable.astro';
import { getStandings } from '@/lib/football-api';
import { getPosts } from '@/lib/wordpress';

// Fetch standings
const standings = await getStandings();
const topStandings = standings.slice(0, 8); // Top 8 teams

// Fetch latest news
let latestNews: any[] = [];
try {
  const result = await getPosts(3);
  latestNews = result.posts.map((post) => ({
    title: post.title,
    href: `/blog/${post.slug}`,
    date: new Date(post.date).toLocaleDateString('fr-FR', {
      day: 'numeric',
      month: 'short',
    }),
  }));
} catch (error) {
  // Fallback placeholder
  latestNews = [
    { title: 'Articles à venir', href: '/blog', date: 'Bientôt' },
  ];
}
---

<div class="space-y-6">
  <!-- Classement Widget -->
  <div class="card">
    <div class="p-4 border-b border-separator flex items-center justify-between">
      <h3 class="font-condensed font-semibold text-lg">Classement Serie A</h3>
      <a href="/classement" class="text-xs text-accent hover:underline">
        Voir tout →
      </a>
    </div>
    <div class="p-4">
      <StandingsTable standings={topStandings} compact={true} />
    </div>
  </div>

  <!-- Latest News Widget -->
  <div class="card">
    <div class="p-4 border-b border-separator">
      <h3 class="font-condensed font-semibold text-lg">Dernières actus</h3>
    </div>
    <div class="divide-y divide-separator">
      {
        latestNews.map((article) => (
          <a
            href={article.href}
            class="block p-4 hover:bg-accent-light transition-colors"
          >
            <h4 class="text-sm font-medium mb-1 line-clamp-2">
              {article.title}
            </h4>
            <p class="text-xs text-text/60">{article.date}</p>
          </a>
        ))
      }
    </div>
  </div>

  <!-- Newsletter Widget -->
  <div class="card p-4">
    <h3 class="font-condensed font-semibold text-lg mb-3">Newsletter</h3>
    <p class="text-sm text-text/70 mb-4">
      Recevez les dernières actus du Calcio chaque semaine.
    </p>
    <NewsletterForm />
  </div>
</div>
