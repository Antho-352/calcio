---
import type { Standing } from '@/lib/football-api';

interface Props {
  standings: Standing[];
  compact?: boolean;
}

const { standings, compact = false } = Astro.props;
---

<div class="overflow-x-auto">
  <table class="w-full text-sm">
    <thead class="bg-accent-light border-b-2 border-accent">
      <tr>
        <th class="text-left p-3 font-semibold">#</th>
        <th class="text-left p-3 font-semibold">Équipe</th>
        <th class="text-center p-3 font-semibold">Pts</th>
        <th class="text-center p-3 font-semibold">J</th>
        {
          !compact && (
            <>
              <th class="text-center p-3 font-semibold">G</th>
              <th class="text-center p-3 font-semibold">N</th>
              <th class="text-center p-3 font-semibold">P</th>
              <th class="text-center p-3 font-semibold">BP</th>
              <th class="text-center p-3 font-semibold">BC</th>
            </>
          )
        }
        <th class="text-center p-3 font-semibold">Diff</th>
        {!compact && <th class="text-center p-3 font-semibold">Forme</th>}
      </tr>
    </thead>
    <tbody>
      {
        standings.map((standing, index) => (
          <tr
            class={`border-b border-separator hover:bg-accent-light/50 transition-colors ${
              index < 4
                ? 'bg-blue-50/30'
                : index < 6
                  ? 'bg-green-50/30'
                  : index >= standings.length - 3
                    ? 'bg-red-50/30'
                    : ''
            }`}
          >
            <td class="p-3 font-semibold text-text/80">{standing.position}</td>
            <td class="p-3">
              <a
                href={`/equipes/${standing.team.name.toLowerCase().replace(/\s+/g, '-')}`}
                class="flex items-center gap-2 hover:text-accent transition-colors"
              >
                {standing.team.logo && (
                  <img
                    src={standing.team.logo}
                    alt={standing.team.name}
                    class="w-6 h-6 object-contain"
                    loading="lazy"
                  />
                )}
                <span class="font-medium">{standing.team.name}</span>
              </a>
            </td>
            <td class="p-3 text-center font-bold">{standing.points}</td>
            <td class="p-3 text-center text-text/70">{standing.played}</td>
            {!compact && (
              <>
                <td class="p-3 text-center text-text/70">{standing.won}</td>
                <td class="p-3 text-center text-text/70">{standing.draw}</td>
                <td class="p-3 text-center text-text/70">{standing.lost}</td>
                <td class="p-3 text-center text-text/70">{standing.goalsFor}</td>
                <td class="p-3 text-center text-text/70">
                  {standing.goalsAgainst}
                </td>
              </>
            )}
            <td
              class={`p-3 text-center font-medium ${
                standing.goalDifference > 0
                  ? 'text-green-600'
                  : standing.goalDifference < 0
                    ? 'text-red-600'
                    : 'text-text/70'
              }`}
            >
              {standing.goalDifference > 0 ? '+' : ''}
              {standing.goalDifference}
            </td>
            {!compact && standing.form && (
              <td class="p-3 text-center">
                <div class="flex justify-center gap-0.5">
                  {standing.form.split('').map((result, i) => (
                    <span
                      class={`w-5 h-5 rounded-sm flex items-center justify-center text-xs font-bold text-white ${
                        result === 'W'
                          ? 'bg-green-500'
                          : result === 'D'
                            ? 'bg-gray-400'
                            : 'bg-red-500'
                      }`}
                    >
                      {result}
                    </span>
                  ))}
                </div>
              </td>
            )}
          </tr>
        ))
      }
    </tbody>
  </table>
</div>

{
  !compact && (
    <div class="mt-4 flex flex-wrap gap-4 text-xs text-text/70">
      <div class="flex items-center gap-2">
        <div class="w-4 h-4 bg-blue-50 border border-blue-200" />
        <span>Champions League</span>
      </div>
      <div class="flex items-center gap-2">
        <div class="w-4 h-4 bg-green-50 border border-green-200" />
        <span>Europa League</span>
      </div>
      <div class="flex items-center gap-2">
        <div class="w-4 h-4 bg-red-50 border border-red-200" />
        <span>Relégation</span>
      </div>
    </div>
  )
}
