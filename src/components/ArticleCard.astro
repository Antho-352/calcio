---
interface Props {
  title: string;
  excerpt: string;
  slug: string;
  image?: string;
  date: string;
  category?: string;
}

const { title, excerpt, slug, image, date, category } = Astro.props;

// Format date
const formattedDate = new Date(date).toLocaleDateString('fr-FR', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="card hover:shadow-md transition-shadow">
  {
    image && (
      <a href={`/blog/${slug}`} class="block">
        <img
          src={image}
          alt={title}
          class="w-full h-48 object-cover"
          loading="lazy"
        />
      </a>
    )
  }

  <div class="p-4">
    {
      category && (
        <span class="inline-block px-2 py-1 bg-accent-light text-accent text-xs font-medium rounded-sm mb-2">
          {category}
        </span>
      )
    }

    <h3 class="font-condensed font-semibold text-lg mb-2 line-clamp-2">
      <a href={`/blog/${slug}`} class="hover:text-accent transition-colors">
        {title}
      </a>
    </h3>

    <p class="text-sm text-text/70 mb-3 line-clamp-3">
      {excerpt}
    </p>

    <div class="flex items-center justify-between text-xs text-text/60">
      <time datetime={date}>{formattedDate}</time>
      <a
        href={`/blog/${slug}`}
        class="text-accent font-medium hover:underline"
      >
        Lire la suite →
      </a>
    </div>
  </div>
</article>
