---
import PageLayout from '@/layouts/PageLayout.astro';
---

<PageLayout
  title="Page non trouvée - Vai Calcio"
  description="La page que vous recherchez n'existe pas"
  noindex={true}
>
  <div class="max-w-2xl mx-auto text-center py-16">
    <h1 class="text-6xl font-condensed font-bold text-accent mb-4">404</h1>
    <h2 class="text-3xl font-condensed font-semibold mb-6">
      Page non trouvée
    </h2>
    <p class="text-lg text-text/70 mb-8">
      Désolé, la page que vous recherchez n'existe pas ou a été déplacée.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
      <a
        href="/"
        class="card p-6 hover:bg-accent-light hover:border-accent border border-separator transition-all text-center"
      >
        <h3 class="font-semibold text-lg mb-2">Accueil</h3>
        <p class="text-sm text-text/70">Retour à la page d'accueil</p>
      </a>

      <a
        href="/blog"
        class="card p-6 hover:bg-accent-light hover:border-accent border border-separator transition-all text-center"
      >
        <h3 class="font-semibold text-lg mb-2">Articles</h3>
        <p class="text-sm text-text/70">Voir tous les articles</p>
      </a>

      <a
        href="/classement"
        class="card p-6 hover:bg-accent-light hover:border-accent border border-separator transition-all text-center"
      >
        <h3 class="font-semibold text-lg mb-2">Classement</h3>
        <p class="text-sm text-text/70">Classement de la Serie A</p>
      </a>
    </div>

    <div class="card p-6">
      <h3 class="font-semibold mb-3">Rechercher sur le site</h3>
      <input
        type="search"
        placeholder="Rechercher un article, une équipe..."
        class="w-full px-4 py-3 border border-separator rounded-sm focus:outline-none focus:border-accent"
        id="search-404"
      />
    </div>
  </div>
</PageLayout>
