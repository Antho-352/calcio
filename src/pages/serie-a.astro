---
import PageLayout from '@/layouts/PageLayout.astro';
import ArticleGrid from '@/components/ArticleGrid.astro';
import { getPostsByCategory } from '@/lib/wordpress';

// Fetch all Serie A articles
let posts: any[] = [];
let total = 0;

try {
  const result = await getPostsByCategory('serie-a', 50, 0);
  posts = result.posts.map((post) => ({
    title: post.title,
    excerpt: post.excerpt,
    slug: post.slug,
    image: post.featuredImage?.node.sourceUrl,
    date: post.date,
    category: 'Serie A',
  }));
  total = result.total;
} catch (error) {
  console.warn('WordPress not configured');
  posts = [
    {
      title: 'Actualités Serie A à venir',
      excerpt: 'Les articles sur le championnat italien seront bientôt disponibles.',
      slug: 'serie-a',
      date: new Date().toISOString(),
      category: 'Serie A',
    },
  ];
}
---

<PageLayout
  title="Actualités Serie A - Vai Calcio"
  description="Toute l'actualité de la Serie A : news, analyses, interviews et reportages sur le championnat italien."
  breadcrumbs={[{ label: 'Actualités Serie A', href: '/serie-a' }]}
>
  <!-- Hero Section -->
  <div class="mb-8">
    <h1 class="text-4xl md:text-5xl font-condensed font-bold mb-4">
      Actualités Serie A
    </h1>
    <p class="text-lg text-text/70 mb-6">
      Toute l'actualité du championnat italien : analyses, interviews et
      reportages.
    </p>

    <!-- Quick Links -->
    <div class="flex flex-wrap gap-3">
      <a
        href="/classement"
        class="px-4 py-2 bg-card border border-separator rounded-sm hover:bg-accent-light hover:border-accent transition-all text-sm font-medium"
      >
        Classement
      </a>
      <a
        href="/resultats-calendrier"
        class="px-4 py-2 bg-card border border-separator rounded-sm hover:bg-accent-light hover:border-accent transition-all text-sm font-medium"
      >
        Résultats
      </a>
      <a
        href="/formations-probables"
        class="px-4 py-2 bg-card border border-separator rounded-sm hover:bg-accent-light hover:border-accent transition-all text-sm font-medium"
      >
        Formations probables
      </a>
      <a
        href="/transferts"
        class="px-4 py-2 bg-card border border-separator rounded-sm hover:bg-accent-light hover:border-accent transition-all text-sm font-medium"
      >
        Transferts
      </a>
      <a
        href="/equipes"
        class="px-4 py-2 bg-card border border-separator rounded-sm hover:bg-accent-light hover:border-accent transition-all text-sm font-medium"
      >
        Équipes
      </a>
      <a
        href="/arbitres"
        class="px-4 py-2 bg-card border border-separator rounded-sm hover:bg-accent-light hover:border-accent transition-all text-sm font-medium"
      >
        Statistiques
      </a>
    </div>
  </div>

  <!-- Articles Count -->
  {
    total > 0 && (
      <div class="mb-6">
        <p class="text-sm text-text/60">
          {total} {total > 1 ? 'articles' : 'article'}
        </p>
      </div>
    )
  }

  <!-- Articles Grid -->
  <ArticleGrid articles={posts} columns={3} />

  <!-- Load More (placeholder for future pagination) -->
  {
    total > posts.length && (
      <div class="mt-12 text-center">
        <button class="px-6 py-3 bg-accent text-white rounded-sm hover:bg-accent/90 transition-colors font-medium">
          Charger plus d'articles
        </button>
      </div>
    )
  }
</PageLayout>
