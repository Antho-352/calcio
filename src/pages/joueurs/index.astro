---
import PageLayout from '@/layouts/PageLayout.astro';
import { getTeams, getTeamSquad } from '@/lib/football-api';
import { slugify } from '@/lib/utils';

const teams = await getTeams();

// Aggregate players from all teams via TheSportsDB
const allPlayers: { name: string; photo: string; position: string; nationality: string; teamName: string; teamLogo: string; slug: string }[] = [];

for (const team of teams) {
  const squad = await getTeamSquad(team.espnId ?? team.thesportsdbSlug ?? String(team.id));
  const teamSlug = team.name.toLowerCase().replace(/\s+/g, '-');
  squad.forEach((player) => {
    allPlayers.push({
      name: player.name,
      photo: player.photo,
      position: player.position,
      nationality: player.nationality,
      teamName: team.name,
      teamLogo: team.logo,
      slug: slugify(player.name),
    });
  });
}

// Group by position
const positions: Record<string, typeof allPlayers> = {
  'Attaquants': allPlayers.filter((p) => ['Forward', 'Centre-Forward', 'Striker', 'Winger'].includes(p.position)),
  'Milieux': allPlayers.filter((p) => ['Midfielder', 'Centre-Back', 'Attacking Midfield', 'Defensive Midfield', 'Central Midfield'].includes(p.position)),
  'Défenseurs': allPlayers.filter((p) => ['Defender', 'Centre-Back', 'Left-Back', 'Right-Back', 'Full-Back'].includes(p.position)),
  'Gardiens': allPlayers.filter((p) => ['Goalkeeper'].includes(p.position)),
};

const hasPlayers = allPlayers.length > 0;
---

<PageLayout
  title="Joueurs Serie A - Vai Calcio"
  description="Tous les joueurs de Serie A 2024-25 : effectifs complets des 20 clubs."
  breadcrumbs={[{ label: 'Joueurs', href: '/joueurs' }]}
>
  <div class="mb-8">
    <h1 class="text-4xl md:text-5xl font-condensed font-bold mb-4">
      Joueurs Serie A
    </h1>
    <p class="text-lg text-text/70">
      Effectifs des 20 clubs de Serie A 2024-25.
    </p>
  </div>

  {hasPlayers ? (
    <div class="space-y-8">
      {teams.map((team) => {
        const teamSlug = team.name.toLowerCase().replace(/\s+/g, '-');
        const teamPlayers = allPlayers.filter((p) => p.teamName === team.name);
        if (teamPlayers.length === 0) return null;

        return (
          <div class="card">
            <div class="p-4 border-b border-separator flex items-center gap-3">
              {team.logo && (
                <img src={team.logo} alt={team.name} class="w-8 h-8 object-contain" />
              )}
              <a href={`/equipes/${teamSlug}`} class="font-condensed font-bold text-xl hover:text-accent transition-colors">
                {team.name}
              </a>
              <span class="text-sm text-text/50 ml-auto">{teamPlayers.length} joueurs</span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-3 p-4">
              {teamPlayers.map((player) => (
                <a
                  href={`/joueurs/${player.slug}`}
                  class="flex flex-col items-center gap-2 p-3 rounded hover:bg-accent-light transition-colors text-center"
                >
                  <div class="w-14 h-14 rounded-full overflow-hidden bg-separator flex items-center justify-center">
                    <img
                      src={player.photo || '/player-placeholder.svg'}
                      alt={player.name}
                      class="w-full h-full object-cover"
                      onerror="this.src='/player-placeholder.svg'"
                    />
                  </div>
                  <div>
                    <p class="text-xs font-semibold leading-tight">{player.name}</p>
                    <p class="text-xs text-text/50">{player.position}</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  ) : (
    <div class="card p-8 text-center">
      <p class="text-text/60 mb-2">Chargement des effectifs en cours...</p>
      <p class="text-sm text-text/40">Les données joueurs seront disponibles prochainement.</p>
    </div>
  )}
</PageLayout>
