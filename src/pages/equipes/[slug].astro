---
import PageLayout from '@/layouts/PageLayout.astro';
import { getTeams, getTeam, getMatches, getTeamSquad, getTeamTopScorers } from '@/lib/football-api';
import { slugify } from '@/lib/utils';
import { getPostsByCategory } from '@/lib/wordpress';

export const prerender = true;

export async function getStaticPaths() {
  const teams = await getTeams();
  return teams.map((team) => ({
    params: { slug: team.name.toLowerCase().replace(/\s+/g, '-') },
  }));
}

const { slug } = Astro.params;

const team = await getTeam(slug!);
if (!team) return Astro.redirect('/404');

// Matches du club
const allMatches = await getMatches();
const teamMatches = allMatches.filter(
  (m) => m.homeTeam.id === team.id || m.awayTeam.id === team.id
);
const recentMatches = teamMatches.filter((m) => m.status === 'finished').slice(0, 5);
const upcomingMatches = teamMatches.filter((m) => m.status === 'scheduled').slice(0, 3);

// Effectif via ESPN (2025-26)
const squad = await getTeamSquad(team.espnId ?? team.thesportsdbSlug ?? String(team.id));

// Top scorers via Fantamaster
const topScorers = await getTeamTopScorers(team.id, 7);

// Group squad by position
const attackers = squad.filter((p) => ['Forward', 'Centre-Forward', 'Striker', 'Winger', 'Attacking Midfield'].includes(p.position));
const midfielders = squad.filter((p) => ['Midfielder', 'Central Midfield', 'Defensive Midfield'].includes(p.position));
const defenders = squad.filter((p) => ['Defender', 'Centre-Back', 'Left-Back', 'Right-Back', 'Full-Back'].includes(p.position));
const goalkeepers = squad.filter((p) => ['Goalkeeper'].includes(p.position));
const others = squad.filter((p) => !attackers.includes(p) && !midfielders.includes(p) && !defenders.includes(p) && !goalkeepers.includes(p));

// Articles WordPress liés au club
let articles: { title: string; slug: string; date: string }[] = [];
try {
  const result = await getPostsByCategory(slug!, 6, 0);
  articles = result.posts.map((post) => ({
    title: post.title,
    slug: post.slug,
    date: new Date(post.date).toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' }),
  }));
} catch { articles = []; }

// Couleur principale du club (première couleur TheSportsDB)
const primaryColor = team.colors?.[0] ?? null;
---

<PageLayout
  title={`${team.name} - Serie A - Vai Calcio`}
  description={`Actualités, résultats, effectif et histoire de ${team.name}. Tout sur le club en Serie A.`}
  breadcrumbs={[
    { label: 'Équipes', href: '/equipes' },
    { label: team.name, href: `/equipes/${slug}` },
  ]}
>
  <!-- Header club -->
  <div class="mb-8">
    <div class="flex items-center gap-5 mb-5">
      {team.logo ? (
        <img src={team.logo} alt={team.name} class="w-16 h-16 object-contain flex-shrink-0" />
      ) : (
        <div class="w-16 h-16 rounded bg-separator flex items-center justify-center flex-shrink-0">
          <span class="text-xl font-bold text-text/30">{team.code}</span>
        </div>
      )}
      <div>
        <h1 class="text-4xl md:text-5xl font-condensed font-bold">{team.name}</h1>
        {team.city && <p class="text-text/60 mt-1">{team.city}, Italie</p>}
      </div>
    </div>

    <!-- Infos clés compactes -->
    <div class="flex flex-wrap gap-3">
      {team.stadium && (
        <div class="card px-3 py-2 flex gap-2 items-center">
          <span class="text-xs text-text/50">Stade</span>
          <span class="text-sm font-semibold">{team.stadium}</span>
          {team.stadiumCapacity && (
            <span class="text-xs text-text/40">({team.stadiumCapacity.toLocaleString()} places)</span>
          )}
        </div>
      )}
      {team.founded && (
        <div class="card px-3 py-2 flex gap-2 items-center">
          <span class="text-xs text-text/50">Fondé en</span>
          <span class="text-sm font-semibold">{team.founded}</span>
        </div>
      )}
      {team.colors && team.colors.length > 0 && (
        <div class="card px-3 py-2 flex gap-2 items-center">
          <span class="text-xs text-text/50">Couleurs</span>
          <div class="flex gap-1">
            {team.colors.map((color) => (
              <div class="w-4 h-4 rounded-full border border-separator" style={'background:' + color} />
            ))}
          </div>
        </div>
      )}
      {team.website && (
        <a
          href={'https://' + team.website.replace(/^https?:\/\//, '')}
          target="_blank"
          rel="noopener noreferrer"
          class="card px-3 py-2 flex gap-2 items-center hover:text-accent transition-colors"
        >
          <span class="text-xs text-text/50">Site officiel</span>
          <span class="text-xs text-accent">→</span>
        </a>
      )}
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
    <!-- Contenu principal -->
    <div class="lg:col-span-2 space-y-6">

      {/* Description Wikipedia */}
      {team.description && (
        <div class="card">
          <div class="p-4 border-b border-separator">
            <h2 class="font-condensed font-semibold text-xl">Histoire du club</h2>
          </div>
          <div class="p-5">
            <p class="text-sm leading-relaxed text-text/80">{team.description}</p>
          </div>
        </div>
      )}

      {/* Top buteurs / passeurs (Fantamaster) */}
      {topScorers.length > 0 && (
        <div class="card">
          <div class="p-4 border-b border-separator">
            <h2 class="font-condensed font-semibold text-xl">Statistiques 2025/26</h2>
          </div>
          <div class="divide-y divide-separator">
            <div class="grid grid-cols-4 gap-2 px-4 py-2 text-xs font-semibold text-text/40 uppercase tracking-wide">
              <span class="col-span-2">Joueur</span>
              <span class="text-center">Buts</span>
              <span class="text-center">Passes</span>
            </div>
            {topScorers.map(({ player, goals, assists, caps }) => {
              const playerSlug = slugify(player.name);
              return (
                <div class="flex items-center gap-3 px-4 py-3">
                  <a href={'/joueurs/' + playerSlug} class="flex-1 min-w-0 hover:text-accent transition-colors">
                    <p class="font-semibold text-sm truncate">{player.name}</p>
                    <p class="text-xs text-text/50">{player.position} · {caps} matchs</p>
                  </a>
                  <span class="w-12 text-center text-sm font-bold text-accent">{goals}</span>
                  <span class="w-12 text-center text-sm font-semibold text-text/70">{assists}</span>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {/* Effectif */}
      {squad.length > 0 && (
        <div class="card">
          <div class="p-4 border-b border-separator flex items-center justify-between">
            <h2 class="font-condensed font-semibold text-xl">Effectif 2025/26</h2>
            <span class="text-sm text-text/50">{squad.length} joueurs</span>
          </div>
          <div class="divide-y divide-separator">
            {[
              { label: 'Gardiens', players: goalkeepers },
              { label: 'Défenseurs', players: defenders },
              { label: 'Milieux', players: midfielders },
              { label: 'Attaquants', players: attackers },
              { label: 'Autres', players: others },
            ].filter(({ players }) => players.length > 0).map(({ label, players }) => (
              <div>
                <div class="px-4 py-2 bg-gray-50">
                  <p class="text-xs font-semibold text-text/50 uppercase tracking-wide">{label}</p>
                </div>
                <div class="divide-y divide-separator">
                  {players.map((player) => {
                    const playerSlug = slugify(player.name);
                    return (
                      <a
                        href={`/joueurs/${playerSlug}`}
                        class="flex items-center gap-3 px-4 py-3 hover:bg-accent-light transition-colors"
                      >
                        <div class="w-9 h-9 rounded-full overflow-hidden bg-separator flex items-center justify-center flex-shrink-0">
                          <img
                            src={player.photo || '/player-placeholder.svg'}
                            alt={player.name}
                            class="w-full h-full object-cover"
                            onerror="this.src='/player-placeholder.svg'"
                          />
                        </div>
                        <div class="flex-1 min-w-0">
                          <p class="font-semibold text-sm">{player.name}</p>
                          <p class="text-xs text-text/50">{player.nationality}</p>
                        </div>
                        {player.number && (
                          <span class="text-sm font-bold text-text/30">#{player.number}</span>
                        )}
                      </a>
                    );
                  })}
                </div>
              </div>
            ))}
          </div>
        </div>
      )}

      {/* Derniers résultats */}
      {recentMatches.length > 0 && (
        <div class="card">
          <div class="p-4 border-b border-separator">
            <h2 class="font-condensed font-semibold text-xl">Derniers résultats</h2>
          </div>
          <div class="divide-y divide-separator">
            {recentMatches.map((match) => {
              const isHome = match.homeTeam.id === team.id;
              const opponent = isHome ? match.awayTeam : match.homeTeam;
              const teamScore = isHome ? match.score?.home : match.score?.away;
              const oppScore = isHome ? match.score?.away : match.score?.home;
              const won = teamScore !== undefined && oppScore !== undefined && teamScore > oppScore;
              const lost = teamScore !== undefined && oppScore !== undefined && teamScore < oppScore;

              return (
                <div class="px-4 py-3 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <div class={'w-2 h-2 rounded-full ' + (won ? 'bg-green-500' : lost ? 'bg-red-500' : 'bg-gray-400')} />
                    <span class="text-xs text-text/50">{isHome ? 'DOM' : 'EXT'}</span>
                    <span class="text-sm font-medium">{opponent.name}</span>
                  </div>
                  <span class={'text-sm font-bold ' + (won ? 'text-green-600' : lost ? 'text-red-600' : '')}>
                    {teamScore} – {oppScore}
                  </span>
                </div>
              );
            })}
          </div>
        </div>
      )}

      {/* Prochains matchs */}
      {upcomingMatches.length > 0 && (
        <div class="card">
          <div class="p-4 border-b border-separator">
            <h2 class="font-condensed font-semibold text-xl">Prochains matchs</h2>
          </div>
          <div class="divide-y divide-separator">
            {upcomingMatches.map((match) => {
              const isHome = match.homeTeam.id === team.id;
              const opponent = isHome ? match.awayTeam : match.homeTeam;
              const d = new Date(match.date);
              return (
                <div class="px-4 py-3 flex items-center justify-between">
                  <div class="flex items-center gap-3">
                    <span class="text-xs text-text/50">{isHome ? 'DOM' : 'EXT'}</span>
                    <span class="text-sm font-medium">{opponent.name}</span>
                  </div>
                  <div class="text-right">
                    <p class="text-xs font-semibold">{d.toLocaleDateString('fr-FR', { day: 'numeric', month: 'short' })}</p>
                    <p class="text-xs text-text/50">{d.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' })}</p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}
    </div>

    <!-- Sidebar -->
    <aside class="space-y-6">
      {articles.length > 0 && (
        <div class="card">
          <div class="p-4 border-b border-separator">
            <h3 class="font-condensed font-semibold text-lg">Articles liés</h3>
          </div>
          <div class="divide-y divide-separator">
            {articles.map((article) => (
              <a href={`/blog/${article.slug}`} class="block p-4 hover:bg-accent-light transition-colors">
                <h4 class="text-sm font-medium mb-1 line-clamp-2">{article.title}</h4>
                <p class="text-xs text-text/50">{article.date}</p>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- Liens utiles -->
      <div class="card p-5">
        <h3 class="font-condensed font-semibold text-lg mb-4">Liens utiles</h3>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="/classement" class="flex items-center justify-between hover:text-accent transition-colors">
              <span>Classement</span>
              <span class="text-accent">→</span>
            </a>
          </li>
          <li>
            <a href="/resultats-calendrier" class="flex items-center justify-between hover:text-accent transition-colors">
              <span>Résultats & Calendrier</span>
              <span class="text-accent">→</span>
            </a>
          </li>
          <li>
            <a href="/equipes" class="flex items-center justify-between hover:text-accent transition-colors">
              <span>Toutes les équipes</span>
              <span class="text-accent">→</span>
            </a>
          </li>
        </ul>
      </div>
    </aside>
  </div>
</PageLayout>
