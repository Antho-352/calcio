---
import PageLayout from '@/layouts/PageLayout.astro';

// Organize all site pages by category
const siteStructure = {
  'Pages principales': [
    { title: 'Accueil', href: '/', description: 'Page d\'accueil du site' },
    { title: 'Classement Serie A', href: '/classement', description: 'Classement complet de la Serie A' },
    { title: 'Résultats & Calendrier', href: '/resultats-calendrier', description: 'Tous les matchs de Serie A' },
    { title: 'Formations Probables', href: '/formations-probables', description: 'Compositions d\'équipes probables' },
  ],
  'Actualités': [
    { title: 'Serie A', href: '/serie-a', description: 'Hub actualités Serie A' },
    { title: 'Blog', href: '/blog', description: 'Tous les articles' },
    { title: 'Transferts', href: '/transferts', description: 'Mercato et transferts' },
    { title: 'Coppa Italia', href: '/coppa-italia', description: 'Coupe d\'Italie' },
    { title: 'Squadra Azzurra', href: '/equipe-nationale', description: 'Équipe nationale italienne' },
  ],
  'Équipes': [
    { title: 'AC Milan', href: '/equipes/milan', description: 'Fiche équipe' },
    { title: 'Inter Milan', href: '/equipes/inter', description: 'Fiche équipe' },
    { title: 'Juventus', href: '/equipes/juventus', description: 'Fiche équipe' },
    { title: 'AS Roma', href: '/equipes/roma', description: 'Fiche équipe' },
    { title: 'Napoli', href: '/equipes/napoli', description: 'Fiche équipe' },
    { title: 'Lazio', href: '/equipes/lazio', description: 'Fiche équipe' },
    { title: 'Atalanta', href: '/equipes/atalanta', description: 'Fiche équipe' },
    { title: 'Fiorentina', href: '/equipes/fiorentina', description: 'Fiche équipe' },
  ],
  'Joueurs': [
    { title: 'Dusan Vlahovic', href: '/joueurs/dusan-vlahovic', description: 'Statistiques joueur' },
    { title: 'Lautaro Martinez', href: '/joueurs/lautaro-martinez', description: 'Statistiques joueur' },
  ],
  'Arbitres': [
    { title: 'Daniele Orsato', href: '/arbitres/daniele-orsato', description: 'Statistiques arbitre' },
  ],
  'Informations': [
    { title: 'À propos', href: '/a-propos', description: 'À propos de Vai Calcio' },
    { title: 'Contact', href: '/contact', description: 'Nous contacter' },
    { title: 'Mentions légales', href: '/mentions-legales', description: 'Informations légales' },
  ],
};
---

<PageLayout
  title="Plan du site - Vai Calcio"
  description="Plan complet du site vai-calcio.fr avec toutes les pages organisées par catégorie."
  breadcrumbs={[{ label: 'Plan du site', href: '/sitemap' }]}
>
  <div class="mb-8">
    <h1 class="text-4xl md:text-5xl font-condensed font-bold mb-4">
      Plan du site
    </h1>
    <p class="text-lg text-text/70">
      Retrouvez toutes les pages du site organisées par catégorie.
    </p>
  </div>

  <!-- Site structure -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {
      Object.entries(siteStructure).map(([category, pages]) => (
        <div class="card p-6">
          <h2 class="font-condensed font-semibold text-xl mb-4 pb-2 border-b border-separator">
            {category}
          </h2>
          <ul class="space-y-3">
            {pages.map((page) => (
              <li>
                <a
                  href={page.href}
                  class="block group hover:bg-accent-light p-2 -mx-2 rounded transition-colors"
                >
                  <div class="font-medium text-accent group-hover:underline">
                    {page.title}
                  </div>
                  <div class="text-sm text-text/60 mt-0.5">
                    {page.description}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>

  <!-- SEO notice -->
  <div class="mt-8 card p-6 bg-accent-light">
    <h3 class="font-semibold mb-2">Plan du site XML</h3>
    <p class="text-sm text-text/70 mb-3">
      Pour les moteurs de recherche, consultez le
      <a href="/sitemap-index.xml" class="text-accent hover:underline"
        >sitemap XML</a
      >.
    </p>
  </div>

  <!-- Quick links -->
  <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-4">
    <a href="/classement" class="card p-6 hover:shadow-md transition-shadow">
      <h3 class="font-semibold mb-2">Classement</h3>
      <p class="text-sm text-text/70">Classement complet Serie A</p>
    </a>

    <a
      href="/resultats-calendrier"
      class="card p-6 hover:shadow-md transition-shadow"
    >
      <h3 class="font-semibold mb-2">Résultats</h3>
      <p class="text-sm text-text/70">Tous les matchs de Serie A</p>
    </a>

    <a href="/blog" class="card p-6 hover:shadow-md transition-shadow">
      <h3 class="font-semibold mb-2">Articles</h3>
      <p class="text-sm text-text/70">Toutes les actualités</p>
    </a>
  </div>
</PageLayout>
