---
import PageLayout from '@/layouts/PageLayout.astro';
import { getReferees, getRefereeStats } from '@/lib/football-api';

const referees = await getReferees();
referees.sort((a, b) => a.name.localeCompare(b.name));

// Pre-load stats for the summary table
const statsRows = await Promise.all(
  referees.map(async (r) => {
    const s = await getRefereeStats(r.id);
    return { referee: r, stats: s };
  })
);
---

<PageLayout
  title="Arbitres Serie A - Vai Calcio"
  description="Liste des arbitres de Serie A avec leurs statistiques : cartons, penalties, matchs dirigés."
  breadcrumbs={[{ label: 'Arbitres', href: '/arbitres' }]}
>
  <div class="mb-8">
    <h1 class="text-4xl md:text-5xl font-condensed font-bold mb-4">Arbitres Serie A</h1>
    <p class="text-lg text-text/70">Statistiques des arbitres de Serie A 2025/26.</p>
  </div>

  <!-- Summary stats table -->
  <div class="card mb-8 overflow-x-auto">
    <div class="p-4 border-b border-separator">
      <h2 class="font-condensed font-semibold text-xl">Tableau des statistiques</h2>
    </div>
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b border-separator bg-gray-50">
          <th class="px-4 py-3 text-left font-semibold text-text/60 text-xs uppercase tracking-wide">Arbitre</th>
          <th class="px-3 py-3 text-center font-semibold text-text/60 text-xs uppercase tracking-wide">Matchs</th>
          <th class="px-3 py-3 text-center font-semibold text-text/60 text-xs uppercase tracking-wide">Buts/M</th>
          <th class="px-3 py-3 text-center font-semibold text-yellow-600 text-xs uppercase tracking-wide">Jaunes</th>
          <th class="px-3 py-3 text-center font-semibold text-red-600 text-xs uppercase tracking-wide">Rouges</th>
          <th class="px-3 py-3 text-center font-semibold text-text/60 text-xs uppercase tracking-wide">Pen.</th>
          <th class="px-3 py-3 text-center font-semibold text-text/60 text-xs uppercase tracking-wide">Fautes/M</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-separator">
        {statsRows.map(({ referee, stats }) => {
          const slug = referee.name.toLowerCase().replace(/\s+/g, '-');
          const m = stats?.matches ?? 0;
          return (
            <tr class="hover:bg-accent-light transition-colors">
              <td class="px-4 py-3">
                <a href={'/arbitres/' + slug} class="font-semibold hover:text-accent transition-colors">
                  {referee.name}
                </a>
              </td>
              <td class="px-3 py-3 text-center font-semibold">{m}</td>
              <td class="px-3 py-3 text-center text-text/70">
                {m > 0 ? (stats!.goals / m).toFixed(1) : '-'}
              </td>
              <td class="px-3 py-3 text-center font-semibold text-yellow-600">
                {stats?.yellowCards ?? '-'}
              </td>
              <td class="px-3 py-3 text-center font-semibold text-red-600">
                {stats?.redCards ?? '-'}
              </td>
              <td class="px-3 py-3 text-center text-text/70">
                {stats?.penalties ?? '-'}
              </td>
              <td class="px-3 py-3 text-center text-text/70">
                {m > 0 ? (stats!.fouls / m).toFixed(1) : '-'}
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <!-- Compact referee list -->
  <div class="card">
    <div class="p-4 border-b border-separator">
      <h2 class="font-condensed font-semibold text-xl">Fiches arbitres</h2>
    </div>
    <div class="divide-y divide-separator">
      {referees.map((referee) => {
        const slug = referee.name.toLowerCase().replace(/\s+/g, '-');
        return (
          <a
            href={'/arbitres/' + slug}
            class="flex items-center gap-4 px-4 py-3 hover:bg-accent-light transition-colors"
          >
            <div class="w-10 h-10 rounded-full bg-separator flex items-center justify-center flex-shrink-0 overflow-hidden">
              {referee.photo ? (
                <img src={referee.photo} alt={referee.name} class="w-full h-full object-cover" />
              ) : (
                <span class="text-sm font-bold text-text/30">
                  {referee.name.split(' ').map((n: string) => n[0]).join('').slice(0, 2)}
                </span>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <p class="font-semibold text-sm">{referee.name}</p>
              <p class="text-xs text-text/50">Arbitre Serie A</p>
            </div>
            <span class="text-accent text-sm">→</span>
          </a>
        );
      })}
    </div>
  </div>
</PageLayout>
