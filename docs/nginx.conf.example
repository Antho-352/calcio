# Nginx configuration for vai-calcio.fr
# Place this in /etc/nginx/sites-available/vai-calcio.fr
# Then create symlink: ln -s /etc/nginx/sites-available/vai-calcio.fr /etc/nginx/sites-enabled/

server {
    listen 80;
    listen [::]:80;
    server_name vai-calcio.fr www.vai-calcio.fr;

    # Redirect to HTTPS
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name vai-calcio.fr www.vai-calcio.fr;

    # SSL Configuration (Let's Encrypt)
    ssl_certificate /etc/letsencrypt/live/vai-calcio.fr/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/vai-calcio.fr/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Security Headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;
    add_header Content-Security-Policy "default-src 'self' https:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline';" always;

    # Logging
    access_log /var/log/nginx/vai-calcio-access.log;
    error_log /var/log/nginx/vai-calcio-error.log;

    # Gzip Compression
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript application/json application/javascript application/xml+rss application/rss+xml font/truetype font/opentype application/vnd.ms-fontobject image/svg+xml;

    # Proxy to Node.js (Astro on PM2)
    location / {
        proxy_pass http://127.0.0.1:4321;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # Timeouts
        proxy_connect_timeout 60s;
        proxy_send_timeout 60s;
        proxy_read_timeout 60s;
    }

    # Static files (if served directly by Nginx, optional)
    # location ~* \.(jpg|jpeg|png|gif|ico|css|js|svg|woff|woff2|ttf|eot)$ {
    #     expires 1y;
    #     add_header Cache-Control "public, immutable";
    # }

    # Nginx cache (optional, disabled by default)
    # Enable only if traffic > 10k visitors/day
    # proxy_cache_path /var/cache/nginx/vai-calcio levels=1:2 keys_zone=vai_calcio:10m max_size=100m inactive=60m;
    # proxy_cache vai_calcio;
    # proxy_cache_valid 200 1h;
    # proxy_cache_use_stale error timeout updating http_500 http_502 http_503 http_504;
    # add_header X-Cache-Status $upstream_cache_status;
}
