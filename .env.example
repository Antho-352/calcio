# vai-calcio.fr - Environment Variables
# Copy this file to .env and fill in your values

# ================================
# WordPress Headless
# ================================

# WordPress GraphQL endpoint
WORDPRESS_GRAPHQL_URL=https://wp.vai-calcio.fr/graphql

# Webhook secret for /api/revalidate
REVALIDATE_SECRET=your-secret-token-here

# ================================
# Newsletter (Brevo)
# ================================

# Brevo API key (v3)
BREVO_API_KEY=your-brevo-api-key

# Brevo list ID for newsletter subscribers
BREVO_LIST_ID=1

# ================================
# Football APIs
# ================================

# API-Football (https://www.api-football.com/)
# Live scores, lineups, stats joueurs/arbitres
FOOTBALL_API_KEY=

# Football-data.org (https://www.football-data.org/)
# Classement, calendrier, résultats (backup)
FOOTBALL_DATA_API_KEY=

# TheSportsDB (https://www.thesportsdb.com/)
# Always "1" for free tier (logos, photos)
THESPORTSDB_API_KEY=1

# ================================
# Docker Scraper (Formations)
# ================================

# WordPress REST API for posting formations
WORDPRESS_API_URL=https://wp.vai-calcio.fr/wp-json/wp/v2/formation

# WordPress admin credentials for scraper
WORDPRESS_USER=admin
WORDPRESS_PASSWORD=

# ================================
# Site Configuration
# ================================

# Site URL (production)
PUBLIC_SITE_URL=https://vai-calcio.fr

# Node environment
NODE_ENV=development

# ================================
# Optional - Analytics
# ================================

# Google Analytics 4 ID (optional)
# PUBLIC_GA_ID=G-XXXXXXXXXX

# Plausible Analytics (optional)
# PUBLIC_PLAUSIBLE_DOMAIN=vai-calcio.fr
